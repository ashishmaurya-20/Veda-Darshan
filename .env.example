# Node Environment
NODE_ENV=production

# Server Port (Render dynamically assigns this, defaults to 10000 on Render)
PORT=10000

# Admin Access Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Admin Secret (Used to sign secure admin session tokens)
ADMIN_SECRET=generate_a_random_32_character_secret_here

# Optional: Custom path for user database JSON file
# If using a Render Persistent Disk mounted at /var/data:
# DATA_PATH=/var/data/user_data.json
